# Mesh sandbox credentials (Dashboard > Account > API keys). Never commit the real .env.
MESH_CLIENT_ID=
MESH_API_KEY=

# Optional: webhook secret from Dashboard > Account > API keys > Webhooks (shown once when you register the URL)
MESH_WEBHOOK_SECRET=

# Optional overrides
PORT=3000
MESH_BASE_URL=https://sandbox-integration-api.meshconnect.com
# MERCHANT_WALLET=0x0Ff0000f0A0f0000F0F000000000ffFf00f0F0f0
# MESH_COINBASE_INTEGRATION_ID=
